# Copy to .env and fill in. Defaults below need no AWS account at all
# (CHAT_PROVIDER=simple, STORAGE_BACKEND=local) so `docker compose up` works out of the box.

APP_NAME=AI PDF Chatbot
DEBUG=false

# Database (required). For Docker Compose, DB_HOST/REDIS_HOST are overridden to the
# service names (postgres/redis) automatically -- these values are for running the
# API/worker directly on your machine instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aipdf
DB_USER=postgres
DB_PASSWORD=postgres

# Auth (required) -- generate a real secret, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Storage: "local" (files under ./uploads, no AWS needed) or "s3".
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=ap-south-1

# Chat: "simple" (free, returns the retrieved context -- no AWS needed) or "bedrock".
# Nova models don't support on-demand invocation by bare model ID in most regions --
# use the region's cross-region inference profile ID instead (find yours with:
# aws bedrock list-inference-profiles --region <your-region> --query
# "inferenceProfileSummaries[?contains(inferenceProfileId,'nova-micro')].inferenceProfileId").
# apac.* is correct for ap-south-1 (Mumbai); it'll be us.*/eu.* etc. elsewhere.
CHAT_PROVIDER=simple
CHAT_MODEL_ID=apac.amazon.nova-micro-v1:0
CHAT_MAX_TOKENS=512

# Embeddings always use Bedrock today; only exercised once a document is processed,
# so STORAGE_BACKEND/CHAT_PROVIDER=local/simple still lets the rest of the app run
# without AWS. Set real AWS credentials (below) once you want embeddings to work.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
PGVECTOR_ENABLED=true
PGVECTOR_DIMENSION=1024

# AWS credentials -- only needed for STORAGE_BACKEND=s3, CHAT_PROVIDER=bedrock, or any
# embedding call. Prefer an AWS CLI profile or IAM role; only set these for containers
# that can't reach either (uncomment and fill in):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# CORS: comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Cost/abuse bounds.
MAX_UPLOAD_SIZE_MB=10
MAX_CHUNKS_PER_DOCUMENT=500
EMBEDDING_CONCURRENCY=5
MAX_QUESTIONS_PER_DAY=30
